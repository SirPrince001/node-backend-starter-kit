{
  "name": "node-backend-starter-kit",
  "version": "0.2.9",
  "description": "Interactive CLI to generate modern Node.js + TypeScript backend projects (Express, Sequelize/Prisma/Drizzle, layered structure)",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "backend-starter": "./dist/cli.js",
    "node-backend-starter-kit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "test": "echo \"No tests yet – coming soon\""
  },
  "keywords": [
    "cli",
    "node",
    "typescript",
    "backend",
    "starter-kit",
    "express",
    "sequelize",
    "prisma",
    "drizzle",
    "generator"
  ],
  "author": "Prince Urum",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SirPrince001/node-backend-starter-kit.git"
  },
  "homepage": "https://github.com/SirPrince001/node-backend-starter-kit#readme",
  "bugs": {
    "url": "https://github.com/SirPrince001/node-backend-starter-kit/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "enquirer": "^2.4.1",
    "execa": "^9.5.1",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.19.7",
    "copyfiles": "^2.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  }
}